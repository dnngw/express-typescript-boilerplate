# ──────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust the values.
# Every variable is validated on startup in src/config/env.ts.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs.
TRUST_PROXY=0
# Comma-separated list of allowed origins, or * to allow all.
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
API_DOCS_ENABLED=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boilerplate

# Redis (optional). When empty, an in-memory cache is used.
REDIS_URL=

# Authentication — generate a secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=express-typescript-boilerplate
REFRESH_TOKEN_TTL_DAYS=7

# Authorization
# false = every user has exactly one role, true = users may have several roles.
RBAC_ALLOW_MULTIPLE_ROLES=true
RBAC_CACHE_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Seeder — initial super admin account (used by `npm run db:seed`)
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
